# Blog System Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ===========================================
# JWT Configuration (REQUIRED for production)
# ===========================================
# Generate a secure secret: openssl rand -base64 32
BLOG_JWT_SECRET=your-secure-jwt-secret-here

# ===========================================
# Admin Password (REQUIRED for production)
# ===========================================
# Default admin password (only used if no admin exists)
BLOG_ADMIN_PASSWORD=your-secure-admin-password

# ===========================================
# Database Configuration
# ===========================================
# SQLite (default)
BLOG_DATABASE_DSN=blog.db

# MySQL (uncomment to use)
# BLOG_DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/blog_db?charset=utf8mb4&parseTime=True&loc=Local

# ===========================================
# Redis Configuration (Optional)
# ===========================================
BLOG_REDIS_HOST=localhost
BLOG_REDIS_PORT=6379
BLOG_REDIS_PASSWORD=
BLOG_REDIS_DB=0

# ===========================================
# Application Configuration
# ===========================================
# BLOG_APP_PORT=:8080
# BLOG_APP_MODE=debug  # debug, release, test
