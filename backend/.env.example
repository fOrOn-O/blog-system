# Blog System Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ===========================================
# JWT Configuration (REQUIRED for production)
# ===========================================
# Generate a secure secret: openssl rand -base64 32
BLOG_JWT_SECRET=your-secure-jwt-secret-here

# ===========================================
# Admin Password (REQUIRED for production)
# ===========================================
# Default admin password (only used if no admin exists)
BLOG_ADMIN_PASSWORD=your-secure-admin-password

# ===========================================
# Database Configuration
# ===========================================
# SQLite (default)
BLOG_DATABASE_DRIVER=sqlite
BLOG_DATABASE_DSN=blog.db

# TiDB Cloud / MySQL (replace the values with the connection details from TiDB Cloud)
# BLOG_DATABASE_DRIVER=mysql
# BLOG_DATABASE_DSN=user:password@tcp(gateway01.region.prod.aws.tidbcloud.com:4000)/blog_db?charset=utf8mb4&parseTime=True&loc=UTC&tls=true

# ===========================================
# Redis Configuration (Optional)
# ===========================================
BLOG_REDIS_HOST=localhost
BLOG_REDIS_PORT=6379
BLOG_REDIS_PASSWORD=
BLOG_REDIS_DB=0

# ===========================================
# Application Configuration
# ===========================================
# BLOG_APP_PORT=:8080
# BLOG_APP_MODE=debug  # debug, release, test
