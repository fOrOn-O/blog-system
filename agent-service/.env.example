APP_NAME=blog-agent
APP_ENV=development
LOG_LEVEL=INFO
BLOG_BACKEND_URL=http://localhost:8080
BLOG_BACKEND_TIMEOUT_SECONDS=10
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=30
AGENT_RECURSION_LIMIT=12
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=article_chunks_e5_v1
QDRANT_TIMEOUT_SECONDS=10
EMBEDDING_PROVIDER=local_e5
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
QDRANT_DISTANCE=Cosine
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
RAG_TOP_K=5

# Production / 本地 Cloud smoke test：替换以上对应值，不要提交真实连接凭据。
# APP_ENV=production
# EMBEDDING_PROVIDER=qdrant_cloud
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# EMBEDDING_DIMENSION=384
# QDRANT_DISTANCE=Cosine
# QDRANT_COLLECTION=article_chunks_e5_cloud_v1
# QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
# QDRANT_API_KEY=<render secret>
# Cloud 不安装 local extra，不运行 warm-model，也不手动添加 passage/query 前缀。
